{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:default",
    "opener:default",

    {
      "identifier": "fs:scope",
      "allow": ["$HOME/**"]
    }
  ]
}
